# Copy to .env and adjust. All variables use the MIGRATION_FACTORY_ prefix.

# Logging
MIGRATION_FACTORY_LOG_LEVEL=INFO
MIGRATION_FACTORY_LOG_JSON=false

# Planning defaults
MIGRATION_FACTORY_MAX_WAVE_SIZE=10
MIGRATION_FACTORY_IDLE_CPU_THRESHOLD=0

# AWS deployment infrastructure
MIGRATION_FACTORY_AWS_REGION=us-east-1
MIGRATION_FACTORY_ARTIFACT_BUCKET=migration-factory-artifacts
MIGRATION_FACTORY_STATE_TABLE=migration-factory-state
